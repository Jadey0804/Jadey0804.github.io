---
interface Props {
  locale: 'en' | 'zh';
}

const { locale } = Astro.props;
const isZh = locale === 'zh';
const base = isZh ? '/zh' : '';

const copy = isZh
  ? {
      eyebrow: '玩法策划作品集',
      title: '关卡、机制与战斗。',
      intro: '用可玩的原型、关卡案例与设计拆解，展示从规则构想到测试迭代的完整过程。',
      focus: '方向',
      focusValue: '玩法策划 / 关卡设计',
      tools: '工具',
      toolsValue: 'UE5 · 蓝图 · C++',
      imagePlaceholder: '项目图片占位',
      detailLink: '查看项目详情',
      githubLink: '前往 GitHub 仓库',
      projects: [
        {
          index: '01 / BALATRONT',
          title: 'Balatront',
          type: 'C++ 玩法原型 · 系统设计',
          year: '2026',
          body: '一个使用 C++ 构建的纵向滚动玩法原型，包含动态地图拼接、玩家输入、图像渲染与基于 Alpha 图的碰撞检测。',
          tags: ['C++', '玩法原型', '碰撞系统', '2D 渲染'],
          detailHref: `${base}/projects/balatront/`,
          githubHref: 'https://github.com/Jadey0804/Balatront',
          visualClass: 'balatront-visual',
          visualTitle: 'Balatront',
        },
        {
          index: '02 / SUNKEN CITY',
          title: '沉没之城',
          type: '玩法系统 · 关卡设计',
          year: '2026',
          body: '一款第三人称水下探索游戏，结合移动、氧气压力、系统性交互、环境谜题与鱼群 AI。',
          tags: ['虚幻引擎 5', '蓝图', 'C++', '谜题设计'],
          detailHref: `${base}/projects/sunken-city/`,
          githubHref: 'https://github.com/Jadey0804/SunkenCity',
          visualClass: 'ocean-visual',
          visualTitle: 'SunkenCity',
        },
        {
          index: '03 / SKYFIRE',
          title: 'SkyFire Uprising',
          type: '团队项目 · UI 设计与实现',
          year: '2026',
          body: '一款 Unreal Engine 空战游戏。项目由团队共同完成，我主要负责雷达及其他游戏 UI 的设计与实现。',
          tags: ['虚幻引擎', '团队项目', '雷达界面', '游戏界面'],
          detailHref: `${base}/projects/skyfire/`,
          githubHref: 'https://github.com/pobertt/Skyfire_Uprising_Level4',
          visualClass: 'skyfire-visual',
          visualTitle: 'SkyFire Uprising',
        },
        {
          index: '04 / COZY HORROR GAME',
          title: 'Dreamweaver',
          type: '概念设计 · 叙事解谜',
          year: '2026',
          body: '一款以跨文化民俗为章节结构的温和恐怖解谜概念。玩家进入梦境、收集线索、判断恐惧原型，并通过文化相关的谜题净化噩梦。',
          tags: ['游戏概念', '叙事设计', '谜题设计', '温和恐怖'],
          detailHref: `${base}/projects/cozy-horror/`,
          githubHref: undefined,
          visualClass: 'cozy-visual',
          visualTitle: 'Dreamweaver',
        },
      ],
    }
  : {
      eyebrow: 'Gameplay Design Portfolio',
      title: 'Levels, systems, and combat.',
      intro: 'Playable prototypes, level case studies, and concise breakdowns show the full path from a rule to playtest iteration.',
      focus: 'Focus',
      focusValue: 'Gameplay / Level Design',
      tools: 'Tools',
      toolsValue: 'UE5 · Blueprint · C++',
      imagePlaceholder: 'Project image placeholder',
      detailLink: 'View project details',
      githubLink: 'View GitHub repository',
      projects: [
        {
          index: '01 / BALATRONT',
          title: 'Balatront',
          type: 'C++ gameplay prototype · Systems design',
          year: '2026',
          body: 'A C++ vertical-scrolling gameplay prototype featuring dynamic world tiling, player input, image rendering, and alpha-map collision detection.',
          tags: ['C++', 'Gameplay Prototype', 'Collision', '2D Rendering'],
          detailHref: `${base}/projects/balatront/`,
          githubHref: 'https://github.com/Jadey0804/Balatront',
          visualClass: 'balatront-visual',
          visualTitle: 'BALATRONT',
        },
        {
          index: '02 / SUNKEN CITY',
          title: 'Sunken City',
          type: 'Gameplay systems · Level design',
          year: '2026',
          body: 'A third-person underwater exploration game combining traversal, oxygen pressure, systemic interaction, environmental puzzles, and fish-school AI.',
          tags: ['Unreal Engine 5', 'Blueprint', 'C++', 'Puzzle design'],
          detailHref: `${base}/projects/sunken-city/`,
          githubHref: 'https://github.com/Jadey0804/SunkenCity',
          visualClass: 'ocean-visual',
          visualTitle: 'SUNKEN CITY',
        },
        {
          index: '03 / SKYFIRE',
          title: 'SkyFire Uprising',
          type: 'Team project · UI design and implementation',
          year: '2026',
          body: 'An Unreal Engine aerial-combat game built as a team. My contribution focused on designing and implementing the radar and other in-game UI.',
          tags: ['Unreal Engine', 'Team Project', 'Radar UI', 'Game UI'],
          detailHref: `${base}/projects/skyfire/`,
          githubHref: 'https://github.com/pobertt/Skyfire_Uprising_Level4',
          visualClass: 'skyfire-visual',
          visualTitle: 'SKYFIRE',
        },
      ],
    };
---

<section class="direction-hero direction-design section-pad">
  <div data-reveal>
    <p class="eyebrow"><span class="live-dot"></span>{copy.eyebrow}</p>
    <h1>{copy.title}</h1>
    <p class="direction-intro">{copy.intro}</p>
    <dl class="hero-meta">
      <div><dt>{copy.focus}</dt><dd>{copy.focusValue}</dd></div>
      <div><dt>{copy.tools}</dt><dd>{copy.toolsValue}</dd></div>
    </dl>
  </div>
</section>

<section id="work" class="work-section portfolio-list-section section-pad" aria-label={isZh ? '玩法策划项目' : 'Gameplay design projects'}>
  <div class="project-grid project-grid-single portfolio-project-list">
    {copy.projects.map((project) => (
      <article class="portfolio-list-item" data-reveal>
        <p class="section-index">{project.index}</p>
        <div class="project-card project-featured">
          <a class:list={['project-visual', project.visualClass]} href={project.detailHref} aria-label={`${copy.detailLink}: ${project.title}`}>
            <div class="visual-grid"></div>
            {project.visualClass === 'ocean-visual' ? (
              <svg viewBox="0 0 800 520" aria-hidden="true">
                <path d="M92 346c77-84 112-163 210-170 76-6 105 54 173 26 85-35 139 31 229 119" />
                <path d="M74 397c93-69 188-45 248-111 58-64 106-3 160 9 77 18 138 40 247 109" />
                <circle cx="306" cy="223" r="40" />
                <circle cx="556" cy="278" r="24" />
              </svg>
            ) : project.visualClass === 'skyfire-visual' ? (
              <div class="radar-display" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
            ) : project.visualClass === 'cozy-visual' ? (
              <div class="dream-fragments" aria-hidden="true"><i></i><i></i><i></i></div>
            ) : (
              <div class="flight-path" aria-hidden="true"><i></i><i></i><i></i></div>
            )}
            <div class="visual-tag">{copy.imagePlaceholder}</div>
            <div class="visual-title">{project.visualTitle}</div>
            <div class="visual-coordinate">{copy.detailLink} ↗</div>
          </a>
          <div class="project-body">
            <div class="project-topline"><p>{project.type}</p><span>{project.year}</span></div>
            <h3><a href={project.detailHref}>{project.title}</a></h3>
            <p>{project.body}</p>
            <ul class="tag-list">{project.tags.map((tag) => <li>{tag}</li>)}</ul>
            <div class="project-links">
              <a class="text-link" href={project.detailHref}>{copy.detailLink} <span>→</span></a>
              {project.githubHref && (
                <a class="text-link" href={project.githubHref} target="_blank" rel="noreferrer">{copy.githubLink} <span>↗</span></a>
              )}
            </div>
          </div>
        </div>
      </article>
    ))}
  </div>
</section>
